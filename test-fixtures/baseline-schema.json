{"views": [{"name": "movimentacoes_hoje", "schema": "public", "definition": " SELECT m.id,\n    m.usuario_id,\n    u.usuario,\n    m.descricao,\n    m.valor,\n    m.data,\n    COALESCE(m.pago, false) AS pago,\n    m.tipo,\n    m.forma_pagamento AS forma_pag,\n    u.telefone,\n    u.telegram_id\n   FROM movimentacoes m\n     LEFT JOIN usuarios u ON m.usuario_id = u.id\n  WHERE m.data::date = (CURRENT_TIMESTAMP AT TIME ZONE 'America/Cuiaba'::text)::date AND m.pago IS DISTINCT FROM true AND m.tipo = 'Despesa'::text AND (lower(m.forma_pagamento) = 'boleto'::text OR (m.descricao ~~* '%Recorrente%'::text OR m.descricao ~~* '%Fixo%'::text) AND (m.forma_pagamento = ANY (ARRAY['Boleto'::text, 'Pix'::text, 'Cart\u00c3\u00a3o de D\u00c3\u00a9bito'::text, 'Dinheiro'::text])));"}, {"name": "clientes_cobrar_amanha", "schema": "public", "definition": " SELECT c.id,\n    c.nome,\n    c.telefone,\n    c.valor,\n    c.data_vencimento,\n    c.usuario_id,\n    u.usuario,\n    u.telegram_id\n   FROM clientes c\n     LEFT JOIN usuarios u ON c.usuario_id = u.id\n  WHERE c.data_vencimento = ((CURRENT_TIMESTAMP AT TIME ZONE 'America/Sao_Paulo'::text)::date + 1) AND c.telefone ~ '^[0-9]{8,15}$'::text;"}, {"name": "recebimentos_hoje", "schema": "public", "definition": " SELECT cr.id,\n    cr.usuario_id,\n    u.usuario,\n    u.telegram_id,\n    TRIM(BOTH FROM u.telefone) AS telefone,\n    cr.descricao,\n    cr.valor,\n    cr.data_recebimento,\n    COALESCE(cr.recebido, false) AS recebido\n   FROM contas_receber cr\n     LEFT JOIN usuarios u ON cr.usuario_id = u.id\n  WHERE cr.data_recebimento::date = (CURRENT_TIMESTAMP AT TIME ZONE 'America/Cuiaba'::text)::date AND cr.recebido IS DISTINCT FROM true;"}, {"name": "faturas_vencendo_hoje", "schema": "public", "definition": " SELECT c.id AS cartao_id,\n    c.nome_cartao,\n    c.dia_vencimento,\n    c.dia_fechamento,\n    c.usuario_id,\n    u.usuario AS nome_usuario,\n    u.telegram_id,\n    u.telefone\n   FROM cartoes c\n     LEFT JOIN usuarios u ON c.usuario_id = u.id\n  WHERE LEAST(c.dia_vencimento::numeric, EXTRACT(day FROM date_trunc('month'::text, (CURRENT_TIMESTAMP AT TIME ZONE 'America/Cuiaba'::text)) + '1 mon -1 days'::interval)) = EXTRACT(day FROM (CURRENT_TIMESTAMP AT TIME ZONE 'America/Cuiaba'::text)) AND (EXISTS ( SELECT 1\n           FROM movimentacoes m\n          WHERE m.usuario_id = c.usuario_id AND m.cartao_id = c.id AND m.tipo = 'Despesa'::text AND m.forma_pagamento = 'Cart\u00c3\u00a3o de Cr\u00c3\u00a9dito'::text AND m.mes_fatura::text = to_char((CURRENT_TIMESTAMP AT TIME ZONE 'America/Cuiaba'::text), 'MM/YYYY'::text) AND m.pago IS DISTINCT FROM true));"}], "tables": [{"rls": true, "name": "clientes", "schema": "public", "columns": [{"name": "id", "type": "bigint", "default": null, "notnull": true, "identity": "d"}, {"name": "nome", "type": "text", "default": null, "notnull": true, "identity": ""}, {"name": "telefone", "type": "text", "default": null, "notnull": true, "identity": ""}, {"name": "valor", "type": "numeric", "default": null, "notnull": true, "identity": ""}, {"name": "status", "type": "text", "default": "'Pendente'::text", "notnull": false, "identity": ""}, {"name": "data_vencimento", "type": "date", "default": null, "notnull": false, "identity": ""}, {"name": "usuario_id", "type": "integer", "default": null, "notnull": false, "identity": ""}, {"name": "conta_id", "type": "integer", "default": null, "notnull": false, "identity": ""}, {"name": "referencia_tv", "type": "jsonb", "default": null, "notnull": false, "identity": ""}]}, {"rls": true, "name": "telegram_daily_alerts", "schema": "financeiropro_operacoes", "columns": [{"name": "usuario_id", "type": "integer", "default": null, "notnull": true, "identity": ""}, {"name": "dia", "type": "date", "default": null, "notnull": true, "identity": ""}, {"name": "telegram_id", "type": "bigint", "default": null, "notnull": true, "identity": ""}, {"name": "reservado_em", "type": "timestamp with time zone", "default": "now()", "notnull":